# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (Necessário para scripts de ingestão e bypass de RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API (Necessário para embeddings text-embedding-004 e redação gemini-1.5-flash)
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key

# ISR On-demand Revalidation Secret (utilizado pelo pipeline para compilar novas notícias instantaneamente)
REVALIDATE_SECRET=aigameportal_super_secret_token_2026

# Base Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
