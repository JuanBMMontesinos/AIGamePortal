# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (Necessário para scripts de ingestão e bypass de RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Pool (Suporte a múltiplas chaves com failover automático em caso de cota 429)
# Informe múltiplas chaves separadas por vírgula para balanceamento Round-Robin:
GEMINI_API_KEYS=your-first-gemini-api-key,your-second-gemini-api-key
# Ou utilize a chave única legada como fallback:
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key

# RAWG Video Games Database API (Opcional - para enriquecimento de metadados, estúdios e notas oficiais)
# Obtenha gratuitamente em: https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key-here

# ISR On-demand Revalidation Secret (OBRIGATÓRIO: gere uma chave forte aleatória com openssl rand -hex 32)
# ATENÇÃO: O servidor NÃO adota senhas padrão e recusará requisições com HTTP 500 caso não esteja definida.
REVALIDATE_SECRET=generate_a_random_32_bytes_hex_secret_here
REVALIDATION_SECRET=generate_a_random_32_bytes_hex_secret_here

# Base Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# DISTRIBUIÇÃO SOCIAL MULTI-CANAL (Fase 2)
# ============================================================================

# Telegram Bot API (Envio automático para canal/grupo público)
# Obtenha o token criando um bot com @BotFather e pegue o chat_id (ex: @meucanal ou -1001234567890)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example
TELEGRAM_CHAT_ID=@aigameportal_noticias
TELEGRAM_CHANNEL_ID=@aigameportal_noticias

# X / Twitter API v2 (OAuth 1.0a User Context para criação de Tweets no plano Free)
# Obtenha em https://developer.x.com/en/portal/dashboard criando um projeto com permissões de 'Read and Write'
TWITTER_API_KEY=your-twitter-consumer-api-key
TWITTER_API_SECRET=your-twitter-consumer-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-user-access-token
TWITTER_ACCESS_SECRET=your-twitter-user-access-secret

# ============================================================================
# AFILIADOS & MONETIZAÇÃO (Fase 3)
# ============================================================================

# Tag Oficial do Programa de Associados Amazon Brasil
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=aigameportal-20

# Chave Mestra para Acesso aos Painéis Administrativos (/admin/*)
# OBRIGATÓRIO: Gere uma chave com alta entropia (ex: openssl rand -base64 32).
# ATENÇÃO: O servidor NÃO adota senhas padrão e recusará logins com HTTP 500 caso não esteja definida.
ADMIN_SECRET_KEY=generate_a_strong_random_admin_secret_key_here

# ============================================================================
# GOOGLE ADSENSE & MÍDIA PROGRAMÁTICA (Fase 3)
# ============================================================================

# ID do Cliente Google AdSense (ex: ca-pub-XXXXXXXXXXXXXXXX)
# Se não configurado, o portal ativa automaticamente o Fallback Inteligente (Destaques Gamer / Telegram)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# IDs dos Slots de Anúncio Responsivos do AdSense (Opcionais)
NEXT_PUBLIC_ADSENSE_SLOT_TOP=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_MID=1234567891
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=1234567892

# ============================================================================
# CANAIS SOCIAIS & COMUNIDADES OFICIAIS (Opcionais para sobrescrita)
# ============================================================================
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/MadeByAiGamesBot
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/C6tYRUBPd
NEXT_PUBLIC_X_URL=https://x.com/MadeByAiGames
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@madebyaigames
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/madebyaigames/

# ============================================================================
# NEWSLETTER AUTOMÁTICA & RESEND (Fase 3)
# ============================================================================

# Chave de API da Resend (Obtenha em https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# E-mail de Envio Autenticado (Para testes pode usar onboarding@resend.dev ou seu domínio validado)
RESEND_FROM_EMAIL="AIGamePortal <newsletter@seudominio.com>"

# Segredo para assinatura criptográfica HMAC-SHA256 de tokens de descadastro (Unsubscribe)
# Opcional dedicado: Se não definido, o sistema usará ADMIN_SECRET_KEY ou SUPABASE_SERVICE_ROLE_KEY.
# IMPORTANTE: Se nenhuma chave estiver configurada, a geração/validação falha de forma segura (fail-closed).
NEWSLETTER_UNSUBSCRIBE_SECRET=generate_a_strong_random_secret_here

# ============================================================================
# DISCORD BOT & WEBHOOKS (Fase 4)
# ============================================================================

# Webhook do Discord para o canal de Jogos Grátis e Ofertas Imperdíveis
# Crie em: Configurações do Servidor > Integrações > Webhooks > Novo Webhook
DISCORD_WEBHOOK_FREE_GAMES=https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz_example_webhook_url

# Webhook do Discord para o canal de Notícias Urgentes e Breaking News (Impacto 5/5)
DISCORD_WEBHOOK_NEWS=https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz_example_webhook_url

